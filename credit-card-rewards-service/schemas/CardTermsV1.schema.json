{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CardTermsV1",
  "type": "object",
  "required": ["schema_version", "currency", "annual_fee", "annual_fee_status", "rules"],
  "properties": {
    "schema_version": { "const": "card_terms.v1" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "annual_fee": { "type": ["string", "null"], "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
    "annual_fee_status": { "enum": ["known", "unknown"] },
    "first_year_waiver": { "type": ["boolean", "string", "null"] },
    "foreign_currency_fee_rate": { "type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+)?$" },
    "minimum_monthly_spend": { "type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+)?$" },
    "reset_period": { "type": ["string", "null"], "enum": ["calendar_month", "statement_cycle", "quarterly", null] },
    "excluded_mccs": { "type": "array", "items": { "type": "string" } },
    "cap_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cap_key", "mode"],
        "properties": {
          "cap_key": { "type": "string" },
          "mode": { "enum": ["limited", "unlimited", "unknown"] },
          "amount": { "type": ["string", "null"] },
          "period": { "type": "string" },
          "reset_period": { "type": ["string", "null"], "enum": ["calendar_month", "statement_cycle", "quarterly", null] }
        }
      }
    },
    "qualification_counters": { "type": "array" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_key", "kind", "rate", "reward_unit"],
        "properties": {
          "rule_key": { "type": "string" },
          "kind": { "enum": ["cashback", "miles", "points"] },
          "rate": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
          "reward_unit": { "type": "string" },
          "minimum_spend": { "type": ["string", "null"] },
          "reset_period": { "type": ["string", "null"], "enum": ["calendar_month", "statement_cycle", "quarterly", null] },
          "cap_group_keys": { "type": "array", "items": { "type": "string" } },
          "excluded_mccs": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
